r">Red</ac:parameter></ac:structured-macro></p></td><td ac:local-id="99ae737a-9bac-4181-8d6a-177acd11f40d"><p local-id="7243aa88-2f40-4bcb-9fed-f0cf387a786f">Owner A</p></td></tr><tr ac:local-id="9809d091-380c-4123-a633-0d455165b969"><td ac:local-id="477df486-131b-4c2e-8696-585ce7cfa45a"><p local-id="98f5bc29-dd05-431c-b765-1d17de812370">Section C</p></td><td ac:local-id="7abf7c61-bdae-458b-a09a-b199e912898f"><p local-id="a5a401ac-23eb-48ff-b292-98ea3b7223e5">Additional notes for Section C</p></td><td ac:local-id="af4b8edc-894f-42f4-b235-e9a4b0b3b4ae"><p local-id="79ded56c-36f4-46f9-ab17-986f43b55a2b"><ac:structured-macro ac:name="status" ac:schema-version="1" ac:macro-id="dc90f6ac-23b2-4570-950f-48df138d9796"><ac:parameter ac:name="title">Done</ac:parameter><ac:parameter ac:name="colour">Green</ac:parameter></ac:structured-macro></p></td><td ac:local-id="63c1635c-bbec-4bfe-88c6-960a04a9175d"><p local-id="0b2800fd-7bfc-4906-9b39-2e5dbbb518f3">Reviewer 2</p></td></tr></tbody></table><h2 local-id="58a8c449-a3d5-4941-9ae5-7d2efd8ab089">Expandable Sections</h2><ac:structured-macro ac:name="expand" ac:schema-version="1" data-layout="wide" ac:local-id="aecf8cfe-d0c1-4e77-af68-181bc6cfb9a3" ac:macro-id="141ed112-5019-40aa-bd99-aefe400571ee"><ac:parameter ac:name="title">Demo: Formatting Tips</ac:parameter><ac:parameter ac:name="breakoutWidth">760</ac:parameter><ac:rich-text-body><ul local-id="eb17606d-8ca9-4c03-b45b-580e5fd14138"><li local-id="2ad41fb1-5e3f-42e0-8119-264e563cf81a"><p local-id="0853f165-a77a-489e-b87c-d9d5e6d3985a">Use clear headings to create a logical flow.</p></li><li local-id="e4fd8bc0-1014-4886-87b4-69adb8360ab5"><p local-id="487bcc93-e0d7-451c-8b1b-b6b8efaa4e02">Mix ordered and unordered lists for instructions and references.</p></li><li local-id="29225e59-a64a-4567-a5c2-a896d9ef847d"><p local-id="53e3395b-c856-48b4-a146-fbe36da082af">Apply panels (info, note, success) to highlight key points.</p></li></ul></ac:rich-text-body></ac:structured-macro><ac:structured-macro ac:name="expand" ac:schema-version="1" data-layout="wide" ac:local-id="6180782f-6597-4e22-99a0-011fee370e23" ac:macro-id="c413004d-8a08-4b23-b69f-83de063c1efd"><ac:parameter ac:name="title">Demo: Macros in Practice</ac:parameter><ac:parameter ac:name="breakoutWidth">760</ac:parameter><ac:rich-text-body><ol start="1" local-id="3971718f-aa84-49f2-8eae-a6ce8979946b"><li local-id="d091ade5-c446-4b92-b595-50f0638b49ac"><p local-id="57b5de51-d0ec-4a0a-bb4a-58f264626ee7">Insert a status to indicate progress.</p></li><li local-id="ae9133a5-6063-4cb9-99ff-10d3f516e8df"><p local-id="59d50894-e034-4e1f-8f24-80c78415c082">Use panels to call attention to best practices.</p></li><li local-id="596d7c05-36d9-47f1-b53d-fac3c319294b"><p local-id="a259bdbb-d892-4806-a2b7-93e9a19355f4">Add code blocks for technical snippets or examples.</p></li></ol></ac:rich-text-body></ac:structured-macro><ac:structured-macro ac:name="info" ac:schema-version="1" ac:local-id="9fc15d90-eb94-488b-b999-02d5af8eeb0d" ac:macro-id="16689cb4-24cd-45e2-9fc8-4b57ffb5c343"><ac:rich-text-body><p local-id="f9a6917c-c018-4ad1-a466-bd82e0749aec">This is a fictional demo page. All names, links, and content are placeholders.</p></ac:rich-text-body></ac:structured-macro><h2 local-id="13a97e0e-370c-44c9-9f0f-efa23304c685">Code Examples (Demo)</h2><ac:structured-macro ac:name="code" ac:schema-version="1" ac:local-id="0087fd4c-e7f8-4145-9f8d-4d5444329f1a" ac:macro-id="57d780e2-d785-4ee4-84e1-86f6089d1999"><ac:parameter ac:name="language">js</ac:parameter><ac:parameter ac:name="breakoutMode">wide</ac:parameter><ac:parameter ac:name="breakoutWidth">760</ac:parameter><ac:plain-text-body><![CDATA[function demoExample(name) {
